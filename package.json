{
  "name": "mimicbox",
  "private": true,
  "description": "Mimic Box VTT: a free, local-first tabletop roleplaying platform. Phase 1 is the offline character sheet.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @mimicbox/companion dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "srd:import": "node tools/srd-import/import.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "fake-indexeddb": "^6.2.8",
    "typescript": "7.0.2",
    "vite": "^8.4.0",
    "vitest": "5.1.2"
  }
}
